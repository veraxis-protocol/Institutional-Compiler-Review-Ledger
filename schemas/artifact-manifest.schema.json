{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://veraxis.example/schemas/artifact-manifest.schema.json",
  "type": "object",
  "required": [
    "schema_version",
    "members"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "members": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "bytes",
          "sha256",
          "sha512"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "bytes": {
            "type": "integer",
            "minimum": 0
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "sha512": {
            "type": "string",
            "pattern": "^[0-9a-f]{128}$"
          },
          "mode": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    }
  },
  "additionalProperties": true
}
